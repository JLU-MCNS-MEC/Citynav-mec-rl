# ---- Local data paths / secrets -------------------------------------------
configs/*.local.yaml
configs/*.local.yml
.env
.env.*

# ---- Raw / large data (never commit) --------------------------------------
# Anchor top-level data directories with a leading slash so that source
# packages such as src/data/ are not accidentally ignored.
/data/
data_cache/*
!data_cache/.gitkeep
/weights/
/checkpoints/
*.ply
*.las
*.laz
*.tif
*.tiff
*.h5
*.hdf5

# ---- Training products ----------------------------------------------------
runs/*
!runs/.gitkeep
/logs/
/tb/
/tensorboard/
reports/*
!reports/.gitkeep
events.out.tfevents.*
*.log
nohup.out
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# ---- Experiment caches (stage 04/05) --------------------------------------
experiments/04_visual_goal_global_map_pipeline/cache/
experiments/04_visual_goal_global_map_pipeline/cache_v2/
experiments/04_visual_goal_global_map_pipeline/cache_v2_test/
experiments/05_transformer_m_training/features/
experiments/05_transformer_m_training/features_v2/
experiments/05_transformer_m_training/features_v2_candidates48_INVALID/
experiments/05_transformer_m_training/features_scaled/
experiments/05_transformer_m_training/runs/
experiments/05_transformer_m_training/runs_v2/
experiments/05_transformer_m_training/checkpoints/
experiments/06_closed_loop_success_rate/runs/
experiments/06_closed_loop_success_rate/results/*/episodes/
experiments/06_closed_loop_success_rate/results/*/journal*.jsonl
experiments/06_closed_loop_success_rate/logs/
experiments/08_belief_only_geometric_navigation/results/*/episodes/
experiments/08_belief_only_geometric_navigation/results/*/journal.part*.jsonl
experiments/08_belief_only_geometric_navigation/logs/

# ---- Stage 03B labels (server only; sizes/SHA-256 in results/MANIFEST.json) -
experiments/03b_target_directed_teacher/results/*.npz
experiments/03b_target_directed_teacher/results_naive_15deg/

# ---- Python / tooling -----------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
build/
dist/

